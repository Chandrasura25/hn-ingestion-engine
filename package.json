{
  "name": "hn-ingestion-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Fault-tolerant content ingestion engine for Hacker News jobs (YC job posts + Who is Hiring threads).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api": "tsx src/api/main.ts",
    "worker": "tsx src/worker/main.ts",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "reprocess": "tsx src/db/reprocess-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "bullmq": "^6.7.6",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
