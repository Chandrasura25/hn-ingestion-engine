DATABASE_URL=postgres://ingest:ingest@localhost:5433/ingest
REDIS_URL=redis://localhost:6380
PORT=3000
LOG_LEVEL=info
QUEUE_PREFIX=hn
INGEST_CONCURRENCY=8
INGEST_RATE_LIMIT_PER_SEC=10
INGEST_MAX_ATTEMPTS=6
